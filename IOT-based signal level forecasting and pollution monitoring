#include <Wire.h>
#include <LiquidCrystal_I2C.h>

// I2C LCD address 0x27, 16 columns, 2 rows
LiquidCrystal_I2C lcd(0x27, 16, 2);  // Use the correct address here


// Traffic light pins
const int redLed = D5;    // GPIO14
const int yellowLed = D6; // GPIO12
const int greenLed = D7;  // GPIO13

// Gas sensor analog input (MQ-2)
const int gasSensor1Analog = A0;

// Gas sensor digital output (MQ-135)
const int gasSensor2Digital = D8;  // Changed from D2 to avoid I2C conflict

unsigned long previousMillis = 0;
const long interval = 5000; // 5 seconds for traffic light change
int trafficState = 0;

void setup() {
  Serial.begin(9600);
  Wire.begin(D2, D1); // SDA = D2, SCL = D1 for ESP8266
  lcd.begin();        // Correct initialization for your library
  lcd.backlight();

  pinMode(redLed, OUTPUT);
  pinMode(yellowLed, OUTPUT);
  pinMode(greenLed, OUTPUT);
  pinMode(gasSensor2Digital, INPUT);

  lcd.setCursor(0, 0);
  lcd.print("Pollution Level:    "); // Pad to ensure overwrite
  lcd.setCursor(0, 1);
  lcd.print("Signal: R          ");
  digitalWrite(redLed, HIGH);
  digitalWrite(yellowLed, LOW);
  digitalWrite(greenLed, LOW);
}

void loop() {
  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;
    trafficState = (trafficState + 1) % 3;

    lcd.setCursor(0, 1);           // Clear and write entire line
    lcd.print("Signal: ");         // Write status prefix

    switch (trafficState) {
      case 0: // Red light
        digitalWrite(redLed, HIGH);
        digitalWrite(yellowLed, LOW);
        digitalWrite(greenLed, LOW);
        lcd.print("R          ");   // Pad with spaces to clear old data
        break;
      case 1: // Yellow light
        digitalWrite(redLed, LOW);
        digitalWrite(yellowLed, HIGH);
        digitalWrite(greenLed, LOW);
        lcd.print("Y          ");
        break;
      case 2: // Green light
        digitalWrite(redLed, LOW);
        digitalWrite(yellowLed, LOW);
        digitalWrite(greenLed, HIGH);
        lcd.print("G          ");
        break;
    }
  }

  int gas1Val = analogRead(gasSensor1Analog);
  int gas2Val = digitalRead(gasSensor2Digital);

  // Always clear and re-write full top line with right-aligned value
  lcd.setCursor(0, 0);
  lcd.print("Pollution Level:    "); // Re-pad top line to clear old digits
  lcd.setCursor(16 - String(gas1Val).length(), 0); // Right-align pollution value
  lcd.print(gas1Val);
  lcd.print("  "); // Clear trailing characters

  Serial.print("MQ-2 Analog: ");
  Serial.print(gas1Val);
  Serial.print(" | MQ-135 Digital: ");
  Serial.println(gas2Val);

  delay(200); // Sensor/LCD update rate
}
